# Runtime environment
NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# Persistent paths. Keep these outside the source/release directory.
DATABASE_PATH=/var/lib/quaythuongdha/data.db
UPLOADS_PATH=/var/lib/quaythuongdha/uploads
BACKUP_DIR=/var/backups/quaythuongdha

# Admin password. Use a long random value and do not commit the real .env file.
# If omitted, a new database will not have an admin password configured.
ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional Google Sheets synchronization webhook.
GOOGLE_SHEET_WEBHOOK_URL=
